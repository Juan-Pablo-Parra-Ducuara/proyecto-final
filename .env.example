# Copia este archivo a .env y rellena los valores. NUNCA subas .env al repo.

# PostgreSQL (fuente de verdad)
DATABASE_URL=postgresql+asyncpg://clicker:clicker@localhost:5432/clicker

# Redis (votos en vivo y caché)
REDIS_URL=redis://localhost:6379/0

# Clave que usa el módulo local de cámara para autenticarse
API_KEY=cambia-esta-api-key

# Clave para firmar la cookie de sesión del dashboard
SECRET_KEY=cambia-esta-secret-key

# Contraseña de acceso al dashboard del profesor
DASHBOARD_PASSWORD=cambia-esta-password

# Puerto del servidor
PORT=8000

# Diccionario ArUco: DICT_4X4_50 (por defecto) o DICT_5X5_100 (>30 alumnos o >3 m)
ARUCO_DICT=DICT_4X4_50
